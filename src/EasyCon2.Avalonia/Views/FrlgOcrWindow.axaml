<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyCon2.Avalonia.ViewModels"
        xmlns:controls="using:EasyCon2.Avalonia.Controls"
        x:Class="EasyCon2.Avalonia.Views.FrlgOcrWindow"
        x:DataType="vm:FrlgOcrViewModel"
        Title="FRLG OCR 区域测试 · 170a 增强版"
        Width="1120" Height="820" MinWidth="880" MinHeight="700">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18" RowSpacing="12">
    <StackPanel Spacing="8" IsEnabled="{Binding !IsBusy}">
      <TextBlock Text="框选区域，读取日文 FRLG 场景" FontSize="22" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="冻结采集画面" Command="{Binding CaptureCommand}" />
        <Button Content="打开截图…" Click="OpenImage_Click" />
        <ComboBox ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}" Width="290">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FrlgSceneChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="默认区域" Command="{Binding DefaultRegionCommand}" />
        <Button Content="读取选区" Command="{Binding RecognizeCommand}" />
      </StackPanel>
      <TextBox Text="{Binding TargetNames}" IsVisible="{Binding IsNameScene}"
               PlaceholderText="可选：限制名称候选，例如 ミニリュウ|ハクリュー；留空使用全量日文词典" />
      <TextBlock Text="{Binding SourceDescription}" Opacity="0.7" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#66708090" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
      <controls:FrlgRegionPicker x:Name="RegionPicker" Source="{Binding FrameImage}"
                                 Selection="{Binding Selection, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
    </Border>
    <StackPanel Grid.Row="2" Spacing="8" IsEnabled="{Binding !IsBusy}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="X" VerticalAlignment="Center" /><NumericUpDown Value="{Binding X}" Minimum="0" Maximum="16384" Width="112" FormatString="0" ShowButtonSpinner="False" />
        <TextBlock Text="Y" VerticalAlignment="Center" /><NumericUpDown Value="{Binding Y}" Minimum="0" Maximum="16384" Width="112" FormatString="0" ShowButtonSpinner="False" />
        <TextBlock Text="宽" VerticalAlignment="Center" /><NumericUpDown Value="{Binding RegionWidth}" Minimum="0" Maximum="16384" Width="112" FormatString="0" ShowButtonSpinner="False" />
        <TextBlock Text="高" VerticalAlignment="Center" /><NumericUpDown Value="{Binding RegionHeight}" Minimum="0" Maximum="16384" Width="112" FormatString="0" ShowButtonSpinner="False" />
        <Button Content="保存区域…" Click="SaveRegion_Click" />
        <Button Content="载入区域…" Click="LoadRegion_Click" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding OcrCall}" IsReadOnly="True" FontFamily="Consolas" />
        <Button Grid.Column="1" Content="复制 OCR 调用" Click="CopyCall_Click" />
      </Grid>
    </StackPanel>
    <Border Grid.Row="3" BorderBrush="#44708090" BorderThickness="1" CornerRadius="6" Padding="12">
      <Grid ColumnDefinitions="210,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
        <TextBlock Text="{Binding ResultText}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Details}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="108" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</Window>
