# EasyCon 170a FRLG 日文增强版：独立识别测试，不发送控制器按键。
# 先在 FRLG OCR 窗口选择场景并框选，复制调用中的场景和四个坐标到这里。
# 此处默认是 1920x1080 摘要第一页右侧的日文种族名称。
# 场景可换成 FRLG_JPN_NATURE / LEVEL / WILD_LEVEL / HP / ATTACK / DEFENSE
# 或 FRLG_JPN_SP_ATTACK / SP_DEFENSE / SPEED。坐标须同时改为对应选区。
# 已知名称集合可写 FRLG_JPN_NAME:ミニリュウ|ハクリュー；空候选不强制猜目标。
$日文场景 = "FRLG_JPN_SUMMARY_NAME"
$日文区域X = 1254
$日文区域Y = 224
$日文区域宽 = 408
$日文区域高 = 72
$日文测试轮 = 0
$日文原文A = ""
$日文原文B = ""
$日文原文C = ""
$日文确认值 = ""
$日文成功轮 = 0

PRINT "FRLG 日文场景测试 r2：首次名称/性格读取需要加载模型。"
FOR $日文测试轮 = 1 TO 5
    $日文原文A = OCR($日文区域X, $日文区域Y, $日文区域宽, $日文区域高, $日文场景)
    WAIT 250
    $日文原文B = OCR($日文区域X, $日文区域Y, $日文区域宽, $日文区域高, $日文场景)
    WAIT 250
    $日文原文C = OCR($日文区域X, $日文区域Y, $日文区域宽, $日文区域高, $日文场景)
    $日文确认值 = ""
    IF $日文原文A != ""
        IF $日文原文A == $日文原文B or $日文原文A == $日文原文C
            $日文确认值 = $日文原文A
        ENDIF
    ENDIF
    IF $日文确认值 == "" and $日文原文B != ""
        IF $日文原文B == $日文原文C
            $日文确认值 = $日文原文B
        ENDIF
    ENDIF
    PRINT "轮=" & $日文测试轮 & " A=[" & $日文原文A & "] B=[" & $日文原文B & "] C=[" & $日文原文C & "]"
    IF $日文确认值 != ""
        $日文成功轮 = $日文成功轮 + 1
        PRINT "确认=" & $日文确认值
    ELSE
        PRINT "本轮未确认；检查当前页面、选区和画面清晰度。"
    ENDIF
    WAIT 500
NEXT
PRINT "测试结束：确认轮数=" & $日文成功轮
